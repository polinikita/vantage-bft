# Keeps the docker-bench build context small. This repo accumulates large local-run
# artifacts at the root (native `target/`, `.local-bench-*` benchmark data dirs,
# `.db_test_*` RocksDB fixtures) that docker-bench/Dockerfile's COPY instructions never
# reference -- without this file BuildKit still has to walk and hash all of it (tens of
# GB) on every `docker build`, which alone would blow the "<60s incremental rebuild"
# cache proof regardless of how the Dockerfile itself is structured.
target/
.git/
.local-bench*/
.db_test_*/
.idea/
.DS_Store

# docker-bench's own generated output (regenerated by gen.py every run; never an input
# to the image build).
docker-bench/data/

# fab (benchmark/) artifacts -- never read by docker-bench/Dockerfile.
benchmark/logs/
benchmark/results/
benchmark/__pycache__/
